# Copy to .env and fill in.

OPENROUTER_API_KEY=

# Directory holding the source repositories. Every path in sources.yaml resolves
# against it.
CORTEX_ROOT=/path/to/repos

EMBED_MODEL=openai/text-embedding-3-small
CHAT_MODEL=minimax/minimax-m2.7
TOP_K=5

DATA_ROOT=./data

# Required. Keep it alphanumeric: it is interpolated into DATABASE_URL, and
# characters such as @ : / # % change how the URI parses.
POSTGRES_PASSWORD=

DATABASE_URL=postgresql://cortex:changeme@postgres:5432/cortex

POSTGRES_PUBLISH=127.0.0.1:5433
MCP_PUBLISH=127.0.0.1:18432

# SOURCES_CONFIG=/path/to/sources.yaml
# CONTEXT_PREFIX=1
