VAULT_PATH=/Users/path/to/vault
OPENROUTER_API_KEY=
EMBED_MODEL=openai/text-embedding-3-small
TOP_K=5
CHAT_MODEL=minimax/minimax-m2.7

# Postgres + pgvector (see docker-compose.yml; port 5433 avoids colliding with
# any Postgres a project already runs)
DATABASE_URL=postgresql://cortex:cortex@localhost:5433/cortex

# Optional: override the ingestion source config (defaults to ./sources.yaml)
# SOURCES_CONFIG=/path/to/sources.yaml
